<div class="space-y-6" data-controller="forecasts--real-estate-chart">
  <!-- Chart Section -->
  <div class="bg-container border border-secondary rounded-xl p-6">
    <div class="mb-6">
      <h2 class="text-lg font-medium text-primary mb-1">Net Equity Forecast</h2>
      <p class="text-sm text-secondary">15-year projection of realizable equity (93% of asset value - mortgage remaining)</p>
    </div>

    <div class="h-80" data-forecasts--real-estate-chart-target="chartContainer">
      <div
        id="<%= chart_id %>"
        class="h-full w-full"
        data-controller="time-series-chart"
        data-time-series-chart-data-value="<%= series_data.to_json %>"
        data-time-series-chart-use-labels-value="true"
        data-time-series-chart-use-tooltip-value="true"
      ></div>
    </div>
  </div>

  <!-- Financial Metrics Display -->
  <div class="bg-container border border-secondary rounded-xl p-4">
    <div class="flex items-center gap-2 mb-4">
      <%= helpers.icon "trending-up", class: "w-4 h-4 text-green-600" %>
      <h3 class="text-base font-medium text-primary">Key Financial Metrics</h3>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4">
      <!-- IRR -->
      <div class="text-center">
        <span class="text-xl font-bold text-green-600" data-forecasts--real-estate-chart-target="irrValue">
          Calculating...
        </span>
        <p class="text-xs text-secondary">IRR (%)</p>
      </div>
      
      <!-- Monthly Income -->
      <div class="text-center">
        <span class="text-xl font-bold text-primary" data-forecasts--real-estate-chart-target="monthlyIncomeDisplay">
          $<%= (noi / 12).round(0).to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %>
        </span>
        <p class="text-xs text-secondary">Monthly Income</p>
      </div>
      
      <!-- Monthly Payment -->
      <div class="text-center">
        <span class="text-xl font-bold text-primary" data-forecasts--real-estate-chart-target="monthlyPaymentDisplay">
          $<%= repayment_amount.to_i.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %>
        </span>
        <p class="text-xs text-secondary">Monthly Payment</p>
      </div>
      
      <!-- DSCR -->
      <div class="text-center">
        <span class="text-xl font-bold text-blue-600" data-forecasts--real-estate-chart-target="dscrValue">
          <%= repayment_amount > 0 ? ((noi / 12) / repayment_amount).round(2) : "N/A" %>
        </span>
        <p class="text-xs text-secondary">DSCR</p>
      </div>
      
      <!-- Loan Amount -->
      <div class="text-center">
        <span class="text-xl font-bold text-primary" data-forecasts--real-estate-chart-target="loanAmountDisplay">
          $<%= loan_amount.to_i.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %>
        </span>
        <p class="text-xs text-secondary">Loan Amount</p>
      </div>
      
      <!-- Deposit Amount -->
      <div class="text-center">
        <span class="text-xl font-bold text-primary" data-forecasts--real-estate-chart-target="depositAmountDisplay">
          $<%= (purchase_price - loan_amount).to_i.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %>
        </span>
        <p class="text-xs text-secondary">Deposit Amount</p>
      </div>
    </div>
    
    <!-- Toggle Controls -->
    <div class="mt-6 pt-4 border-t border-secondary">
      <div class="flex flex-wrap gap-6">
        <div class="flex items-center gap-2">
          <input 
            type="checkbox" 
            id="reinvest_cashflows"
            <%= reinvest_cashflows ? 'checked' : '' %>
            data-forecasts--real-estate-chart-target="reinvestCashflows"
            data-action="change->forecasts--real-estate-chart#updateChart"
            class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
          />
          <label for="reinvest_cashflows" class="text-sm text-primary">
            Re-invest cashflows back into mortgage
          </label>
        </div>
        
        <div class="flex items-center gap-2">
          <input 
            type="checkbox" 
            id="adjust_for_inflation"
            <%= adjust_for_inflation ? 'checked' : '' %>
            data-forecasts--real-estate-chart-target="adjustForInflation"
            data-action="change->forecasts--real-estate-chart#toggleInflationInput change->forecasts--real-estate-chart#updateChart"
            class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
          />
          <label for="adjust_for_inflation" class="text-sm text-primary">
            Adjust all numbers for inflation
          </label>
        </div>
        
        <!-- Inflation Rate Input (conditional) -->
        <div class="flex items-center gap-2" data-forecasts--real-estate-chart-target="inflationRateContainer" style="<%= adjust_for_inflation ? '' : 'display: none;' %>">
          <label for="inflation_rate" class="text-sm text-primary whitespace-nowrap">
            Inflation Rate (%):
          </label>
          <input 
            type="number"
            id="inflation_rate"
            value="<%= inflation_rate %>"
            step="0.1"
            min="0"
            max="10"
            data-forecasts--real-estate-chart-target="inflationRate"
            data-action="input->forecasts--real-estate-chart#updateChart"
            class="w-20 text-sm border border-secondary rounded px-2 py-1"
            placeholder="3.0"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Input Sections -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Property Box -->
    <div class="bg-container border border-secondary rounded-xl p-4">
      <h3 class="text-base font-medium text-primary mb-4 flex items-center gap-2">
        <%= helpers.icon "home", class: "w-4 h-4" %>
        Property
      </h3>
      <div class="space-y-4">
        <div class="form-field">
          <div class="form-field__body">
            <label class="form-field__label" for="purchase_price">
              Purchase Price
            </label>
            <input
              type="number"
              id="purchase_price"
              value="<%= purchase_price.to_i %>"
              data-forecasts--real-estate-chart-target="purchasePrice"
              data-action="input->forecasts--real-estate-chart#onPurchasePriceChange"
              class="form-field__input"
              placeholder="500000"
            />
          </div>
        </div>
        <div class="form-field">
          <div class="form-field__body">
            <label class="form-field__label" for="depreciable_value">
              Depreciable Value
            </label>
            <input
              type="number"
              id="depreciable_value"
              value="<%= depreciable_value.to_i %>"
              data-forecasts--real-estate-chart-target="depreciableValue"
              data-action="input->forecasts--real-estate-chart#updateChart"
              class="form-field__input"
              placeholder="400000"
            />
          </div>
        </div>
        <div class="form-field">
          <div class="form-field__body">
            <label class="form-field__label" for="exit_cap_rate">
              Exit Cap Rate (%)
            </label>
            <input
              type="number"
              id="exit_cap_rate"
              value="<%= exit_cap_rate %>"
              step="0.1"
              min="0"
              max="20"
              data-forecasts--real-estate-chart-target="exitCapRate"
              data-action="input->forecasts--real-estate-chart#updateChart"
              class="form-field__input"
              placeholder="6.0"
            />
          </div>
        </div>
        <div class="form-field">
          <div class="form-field__body">
            <label class="form-field__label" for="hold_period">
              Hold Period (Years)
            </label>
            <input
              type="number"
              id="hold_period"
              value="<%= hold_period %>"
              step="1"
              min="1"
              max="50"
              data-forecasts--real-estate-chart-target="holdPeriod"
              data-action="input->forecasts--real-estate-chart#updateChart"
              class="form-field__input"
              placeholder="15"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Income Box -->
    <div class="bg-container border border-secondary rounded-xl p-4">
      <h3 class="text-base font-medium text-primary mb-4 flex items-center gap-2">
        <%= helpers.icon "dollar-sign", class: "w-4 h-4" %>
        Income
      </h3>
      <div class="space-y-4">
        <div class="form-field">
          <div class="form-field__body">
            <label class="form-field__label" for="cap_rate">
              Cap Rate (%)
            </label>
            <input
              type="number"
              id="cap_rate"
              value="<%= cap_rate %>"
              step="0.1"
              min="0"
              max="20"
              data-forecasts--real-estate-chart-target="capRate"
              data-action="input->forecasts--real-estate-chart#onCapRateChange"
              class="form-field__input"
              placeholder="5.0"
            />
          </div>
        </div>
        <div class="form-field">
          <div class="form-field__body">
            <label class="form-field__label" for="noi">
              NOI (Net Operating Income)
            </label>
            <input
              type="number"
              id="noi"
              value="<%= noi.to_i %>"
              data-forecasts--real-estate-chart-target="noi"
              data-action="input->forecasts--real-estate-chart#onNOIChange"
              class="form-field__input"
              placeholder="25000"
            />
          </div>
        </div>
        <div class="form-field">
          <div class="form-field__body">
            <label class="form-field__label" for="rent_bump_rate">
              Rent Bump Rate (%)
            </label>
            <input
              type="number"
              id="rent_bump_rate"
              value="<%= rent_bump_rate %>"
              step="0.1"
              min="0"
              max="10"
              data-forecasts--real-estate-chart-target="rentBumpRate"
              data-action="input->forecasts--real-estate-chart#updateChart"
              class="form-field__input"
              placeholder="2.5"
            />
          </div>
        </div>
        <div class="form-field">
          <div class="form-field__body">
            <label class="form-field__label" for="dscr_buffer">
              DSCR Buffer (%)
            </label>
            <input
              type="number"
              id="dscr_buffer"
              value="<%= dscr_buffer %>"
              step="0.1"
              min="0"
              max="50"
              data-forecasts--real-estate-chart-target="dscrBuffer"
              data-action="input->forecasts--real-estate-chart#updateMetricsDisplay"
              class="form-field__input"
              placeholder="10.0"
            />
          </div>
        </div>

      </div>
    </div>

    <!-- Mortgage Box -->
    <div class="bg-container border border-secondary rounded-xl p-4">
      <h3 class="text-base font-medium text-primary mb-4 flex items-center gap-2">
        <%= helpers.icon "calculator", class: "w-4 h-4" %>
        Mortgage
      </h3>
      <div class="space-y-4">
        <div class="form-field">
          <div class="form-field__body">
            <label class="form-field__label" for="deposit_percentage">
              Deposit Percentage (%)
            </label>
            <input
              type="number"
              id="deposit_percentage"
              value="<%= deposit_percentage %>"
              step="1"
              min="0"
              max="100"
              data-forecasts--real-estate-chart-target="depositPercentage"
              data-action="input->forecasts--real-estate-chart#onDepositPercentageChange"
              class="form-field__input"
              placeholder="20.0"
            />
          </div>
        </div>
        <div class="form-field">
          <div class="form-field__body">
            <label class="form-field__label" for="interest_rate">
              Interest Rate (%)
            </label>
            <input
              type="number"
              id="interest_rate"
              value="6.5"
              step="0.1"
              min="0"
              max="20"
              data-forecasts--real-estate-chart-target="interestRate"
              data-action="input->forecasts--real-estate-chart#updateLoanCalculations input->forecasts--real-estate-chart#updateChart"
              class="form-field__input"
              placeholder="6.5"
            />
          </div>
        </div>
        <div class="form-field">
          <div class="form-field__body">
            <label class="form-field__label" for="loan_term">
              Loan Term (Years)
            </label>
            <input
              type="number"
              id="loan_term"
              value="<%= loan_term %>"
              step="1"
              min="1"
              max="50"
              data-forecasts--real-estate-chart-target="loanTerm"
              data-action="input->forecasts--real-estate-chart#updateLoanCalculations input->forecasts--real-estate-chart#updateChart"
              class="form-field__input"
              placeholder="15"
            />
          </div>
        </div>
        <div class="form-field">
          <div class="form-field__body">
            <label class="form-field__label" for="amortization_schedule">
              Amortization Schedule (Years)
            </label>
            <input
              type="number"
              id="amortization_schedule"
              value="<%= amortization_schedule %>"
              step="1"
              min="1"
              max="50"
              data-forecasts--real-estate-chart-target="amortizationSchedule"
              data-action="input->forecasts--real-estate-chart#updateLoanCalculations input->forecasts--real-estate-chart#updateChart"
              class="form-field__input"
              placeholder="25"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Projection Table -->
  <div class="bg-container border border-secondary rounded-xl p-6">
    <div class="mb-4">
      <h3 class="text-lg font-medium text-primary mb-1">Financial Projection</h3>
      <p class="text-sm text-secondary">Detailed yearly breakdown of investment performance</p>
    </div>
    
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="py-3 px-2 text-left font-medium text-secondary">Year</th>
            <th class="py-3 px-2 text-right font-medium text-secondary">Asset Value</th>
            <th class="py-3 px-2 text-right font-medium text-secondary">Mortgage Remaining</th>
            <th class="py-3 px-2 text-right font-medium text-secondary">Net Equity</th>
            <th class="py-3 px-2 text-right font-medium text-secondary">NOI</th>
            <th class="py-3 px-2 text-right font-medium text-secondary">Interest Paid</th>
            <th class="py-3 px-2 text-right font-medium text-secondary">Profit</th>
            <th class="py-3 px-2 text-right font-medium text-secondary">Cash Flow</th>
            <th class="py-3 px-2 text-right font-medium text-secondary">After-Tax Cash Flow</th>
          </tr>
        </thead>
        <tbody data-forecasts--real-estate-chart-target="projectionTableBody">
          <!-- Rows will be populated by JavaScript -->
        </tbody>
      </table>
    </div>
  </div>
</div>